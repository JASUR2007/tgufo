# Database Configuration
POSTGRES_USER=youtube_user
POSTGRES_PASSWORD=youtube_pass
POSTGRES_DB=youtube_db
DATABASE_URL=postgresql+asyncpg://youtube_user:youtube_pass@postgres:5432/youtube_db

# Security & Tokens
SECRET_KEY=super-secret-youtube-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage: "minio" or "local"
STORAGE_TYPE=minio
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword
S3_BUCKET_NAME=youtube-videos
S3_PUBLIC_URL=http://localhost:9005
LOCAL_STORAGE_DIR=storage

# Uploads
MAX_UPLOAD_SIZE_MB=500
